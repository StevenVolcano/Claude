<?xml version="1.0" encoding="utf-8"?>
<!-- Stylized terminus roundel: an outer ring with a horizontal name-bar,
     and a filled "end of the line" stop dot in the middle. -->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">
    <group>
        <!-- outer ring -->
        <path
            android:pathData="M54,54 m-26,0 a26,26 0 1,1 52,0 a26,26 0 1,1 -52,0"
            android:strokeColor="#E63946"
            android:strokeWidth="9"
            android:fillColor="#00000000" />
        <!-- horizontal bar across the roundel -->
        <path
            android:pathData="M22,49 h64 v10 h-64 z"
            android:fillColor="#F1FAEE" />
        <!-- terminus stop dot -->
        <path
            android:pathData="M54,54 m-6,0 a6,6 0 1,1 12,0 a6,6 0 1,1 -12,0"
            android:fillColor="#1D3557" />
    </group>
</vector>
